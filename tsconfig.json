{
  "compilerOptions": {
    "target":              "ES2020",
    "module":              "ESNext",
    "lib":                 ["ES2020", "DOM"],
    "moduleResolution":    "bundler",
    "strict":              true,
    "noUnusedLocals":      true,
    "noUnusedParameters":  true,
    "noEmit":              true
  },
  "include": ["src"]
}
